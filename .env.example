# Replace placeholders locally or use Replit Secrets. NEVER commit real values.
# Values here are illustrative names only; not an executable deployment setup.

# Replit auth and API (some variables are Replit-managed)
REPL_ID=REPLIT_ASSIGNED_VALUE
ISSUER_URL=REPLIT_OIDC_ISSUER_FROM_ENVIRONMENT
SESSION_SECRET=REPLACE_WITH_PRIVATE_RANDOM_STRING

# Node API database / storage: configure based on actual Replit project
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE
PRIVATE_OBJECT_DIR=CONFIGURE_IN_REPLIT_STORAGE
PUBLIC_OBJECT_SEARCH_PATHS=CONFIGURE_IF_NEEDED

# Gemini configuration used by source code (if required by current deployment)
AI_INTEGRATIONS_GEMINI_API_KEY=REPLACE_WITH_REAL_KEY_IN_SECRETS_ONLY
AI_INTEGRATIONS_GEMINI_BASE_URL=CONFIGURE_IF_REQUIRED_BY_PROVIDER

# Connected Flask bridge / frontend
FLASK_API_BASE_URL=http://127.0.0.1:5051/api
VITE_DATA_SOURCE=connected
FRONTEND_ORIGINS=http://localhost:5173

# RunPod: not currently integrated. Do not insert fake values or evidence.
